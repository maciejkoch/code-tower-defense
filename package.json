{
  "name": "code-tower-defense",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node tools/build.mjs",
    "build:pages": "node tools/build.mjs --base-href /code-tower-defense/ && npm run verify:pages",
    "verify:build": "node tools/verify-build.mjs",
    "verify:pages": "node tools/verify-build.mjs --base-href=/code-tower-defense/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test:watch": "ng test",
    "balance": "node tools/balance.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:build"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "pixi.js": "8.22.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "22.23.2",
    "npm": "12.0.2"
  }
}
